{
  "name": "mcp-reminders",
  "version": "1.0.0",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "typecheck": "tsc --noEmit",
    "build:check": "bun build index.ts --target=bun --outfile=/tmp/mcp-reminders-build.js && rm -f /tmp/mcp-reminders-build.js",
    "check": "bun run typecheck && bun run build:check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
